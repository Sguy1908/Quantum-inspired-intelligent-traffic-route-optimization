#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/vercel/share/v0-project/frontend/node_modules/.pnpm/shadcn@4.19.0_typescript@5.7.3/node_modules/shadcn/node_modules:/vercel/share/v0-project/frontend/node_modules/.pnpm/shadcn@4.19.0_typescript@5.7.3/node_modules:/vercel/share/v0-project/frontend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/vercel/share/v0-project/frontend/node_modules/.pnpm/shadcn@4.19.0_typescript@5.7.3/node_modules/shadcn/node_modules:/vercel/share/v0-project/frontend/node_modules/.pnpm/shadcn@4.19.0_typescript@5.7.3/node_modules:/vercel/share/v0-project/frontend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../shadcn/dist/index.js" "$@"
else
  exec node  "$basedir/../shadcn/dist/index.js" "$@"
fi
